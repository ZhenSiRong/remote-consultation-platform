{
  "name": "bahmni2",
  "viewport": { "width": 1440, "height": 900 },
  "steps": [
    { "goto": "https://demo.standard.mybahmni.in/bahmni/home" },
    { "wait": 7000 },
    { "fill": { "selector": "#username", "value": "superman" } },
    { "fill": { "selector": "#password", "value": "Admin123" } },
    { "js": "(()=>{const b=[...document.querySelectorAll('button')].find(x=>/login/i.test(x.textContent)); if(b){b.click(); return 'clicked';} return 'notfound';})()" },
    { "wait": 9000 },
    { "js": "(()=>{const s=document.querySelector('select'); if(!s) return 'no-select'; const opt=[...s.options].find(o=>o.value && !/select location/i.test(o.text)); if(!opt) return 'no-opt'; s.value=opt.value; s.dispatchEvent(new Event('change',{bubbles:true})); return 'set:'+opt.text;})()" },
    { "wait": 1500 },
    { "js": "(()=>{const b=[...document.querySelectorAll('button')].find(x=>/continue/i.test(x.textContent)); if(b){b.click(); return 'clicked';} return 'notfound';})()" },
    { "wait": 10000 },
    { "js": "(()=>{const el=[...document.querySelectorAll('div,button,a')].find(x=>x.textContent.trim()==='Registration'); if(el){el.click(); return 'clicked';} return 'notfound';})()" },
    { "wait": 10000 },
    { "js": "document.title + ' | ' + location.href" },
    { "shot": "screenshots/bahmni/05_registration_search.png" }
  ]
}
