# 远程会诊平台 · 后端环境变量（示例）
# 只列变量名与说明，真实值走本地 .env / 部署侧注入，不入库不入仓（R11）
# B-07 负责启动期校验（缺失即 fail-fast 并报出变量名），本文件仅作清单

NODE_ENV=development
PORT=3000

# PostgreSQL 16（B-06）；开发/测试同一镜像，不用 SQLite
DATABASE_URL=postgresql://app_rw:CHANGE_ME@localhost:5432/rcp?schema=public

# 会话与令牌（B-08）；密钥走环境变量或本地 KMS
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=8h

# adapter 开关（3.8.5 规则 2：配置驱动注入，禁止在业务里写 if provider === 'x'）
VIDEO_PROVIDER=fake
DICOM_PROVIDER=fake
SIGN_PROVIDER=mock
STORAGE_PROVIDER=fake
ASR_PROVIDER=fake

# 日志级别（B-03）
LOG_LEVEL=debug
