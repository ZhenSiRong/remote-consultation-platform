// 远程会诊平台 · Prisma schema（B-01 只放占位，B-06 才建表）
// 定稿：PostgreSQL 16（决策 B-02）。开发/测试同一 Docker 镜像，不用 SQLite（架构决策.md:675）。
// 本步刻意不写任何 model：迁移基线、6 域主表、audit schema 与分区/触发器/REVOKE 手写 SQL 都在 B-06。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

